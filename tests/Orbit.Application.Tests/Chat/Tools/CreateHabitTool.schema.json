{
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "emoji": {
      "type": [
        "string",
        "null"
      ],
      "description": "Emoji icon. Pick a relevant one when clear."
    },
    "frequency_unit": {
      "type": [
        "string",
        "null"
      ],
      "description": "A Task is one-time: frequency_unit=OneTime in create tools, stored as null, with due_date and requested due_time. A dated event or single dated instruction is a Task unless repetition was requested. A Habit has Day, Week, Month or Year and a positive frequency_quantity. Daily weekdays require Day/1; is_flexible tracks a quantity within a window and cannot have weekdays. General items have no schedule, recurrence or avoid type. end_date is inclusive and only recurring items use it. A temporary instruction for N days before an event uses one Task per day or a recurring Habit with end_date equal to the event date. Never leave temporary preparation recurring indefinitely. Morning and evening routines imply Day/1; weekday routines use Day/1 with days. Propose that cadence without asking.",
      "enum": [
        "Day",
        "Week",
        "Month",
        "Year",
        "OneTime"
      ]
    },
    "frequency_quantity": {
      "type": "integer",
      "description": "How often. Defaults to 1."
    },
    "interval_weeks": {
      "type": "integer",
      "description": "Repeat interval in weeks. Omit for every week. Minimum 1."
    },
    "days": {
      "type": "array",
      "description": "Specific weekdays. Only when frequency_quantity is 1.",
      "items": {
        "type": "string",
        "enum": [
          "Sunday",
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday"
        ]
      }
    },
    "due_date": {
      "type": "string",
      "description": "YYYY-MM-DD. Defaults to today."
    },
    "end_date": {
      "type": [
        "string",
        "null"
      ],
      "description": "YYYY-MM-DD. Optional end date."
    },
    "due_time": {
      "type": "string",
      "description": "HH:mm"
    },
    "due_end_time": {
      "type": [
        "string",
        "null"
      ],
      "description": "HH:mm end time or deadline."
    },
    "is_bad_habit": {
      "type": "boolean",
      "description": "Use is_bad_habit=true only for ongoing reduction or slip tracking, named for the behaviour itself: Fumar, Tomar multivitamínico, Smoking, Drinking soda. For quero parar de fumar or I want to drink less soda, choose that avoid form. A temporary or dated abstinence is a positive commitment, is_bad_habit=false, named Não tomar multivitamínico or Don't take multivitamins, once or within its explicit date range. Never combine an avoid type with a negated name: não, sem, parar de, evitar, don't, stop, avoid."
    },
    "is_general": {
      "type": "boolean",
      "description": "Whether this is a general habit with no schedule. Defaults to false."
    },
    "is_flexible": {
      "type": "boolean",
      "description": "Window-based tracking. Requires frequency_unit."
    },
    "checklist_items": {
      "type": "array",
      "description": "Atomic sub-steps done together in one execution.",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "is_checked": {
            "type": "boolean",
            "description": "Default: false."
          }
        },
        "required": [
          "text"
        ]
      }
    },
    "start_date": {
      "type": "string",
      "description": "YYYY-MM-DD recurrence anchor."
    },
    "reminder_enabled": {
      "type": "boolean"
    },
    "reminder_times": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "scheduled_reminders": {
      "type": "array",
      "description": "Absolute-time reminders for habits WITHOUT a due_time",
      "items": {
        "type": "object",
        "properties": {
          "when": {
            "type": "string",
            "enum": [
              "day_before",
              "same_day"
            ]
          },
          "time": {
            "type": "string",
            "description": "HH:mm 24h format"
          }
        },
        "required": [
          "when",
          "time"
        ]
      }
    },
    "relative_reminders": {
      "type": "array",
      "description": "Reminders relative to due_time: minutes_before, or when (day_before/same_day) and time (HH:mm). Empty array clears them.",
      "items": {
        "type": "object",
        "properties": {
          "minutes_before": {
            "type": "integer"
          },
          "when": {
            "type": "string",
            "enum": [
              "day_before",
              "same_day"
            ]
          },
          "time": {
            "type": "string"
          }
        }
      }
    },
    "slip_alert_enabled": {
      "type": "boolean"
    },
    "tag_names": {
      "type": "array",
      "items": {
        "type": "string"
      }

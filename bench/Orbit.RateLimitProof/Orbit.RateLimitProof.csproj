<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <OrbitApiRoot Condition="'$(OrbitApiRoot)' == ''">$(MSBuildThisFileDirectory)../..</OrbitApiRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(OrbitApiRoot)/src/Orbit.Infrastructure/Orbit.Infrastructure.csproj" />
  </ItemGroup>
</Project>

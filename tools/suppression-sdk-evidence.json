{
  "packages": {
    "ModelContextProtocol.Core": "1.4.1",
    "MediatR": "14.2.0"
  },
  "mediatrDelegate": "System.Threading.Tasks.Task`1[System.String] Invoke(System.Threading.CancellationToken)",
  "mediatrWrapperSource": "https://github.com/LuckyPennySoftware/MediatR/blob/916ef1b3d68ccdc96db8f914eaf1b32fc7db52c5/src/MediatR/Wrappers/RequestHandlerWrapper.cs",
  "toolSchemas": {
    "ApiKeyTools.ManageApiKeys": {
      "type": "object",
      "properties": {
        "action": {
          "description": "Action to perform: create or revoke",
          "type": "string"
        },
        "keyId": {
          "description": "For revoke: the API key ID (GUID)",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "name": {
          "description": "For create: the key name",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "scopes": {
          "description": "For create: comma-separated scope names",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "isReadOnly": {
          "description": "For create: whether the key is read-only",
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "expiresAtUtc": {
          "description": "For create: ISO-8601 UTC expiry timestamp",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "confirmationToken": {
          "description": "Confirmation token from confirm_agent_operation_v2, after step_up_agent_operation_v2 and verify_step_up_agent_operation_v2 (required: managing API keys is high-risk and needs step-up)",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "action"
      ]
    },
    "GoalTools.CreateGoal": {
      "type": "object",
      "properties": {
        "title": {
          "description": "Goal title",
          "type": "string"
        },
        "targetValue": {
          "description": "Target value to reach",
          "type": "number"
        },
        "unit": {
          "description": "Unit of measurement (e.g., km, books, hours)",
          "type": "string"
        },
        "description": {
          "description": "Optional description",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "deadline": {
          "description": "Optional deadline in YYYY-MM-DD format",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "type": {
          "description": "Goal type: Standard (default) or Streak",
          "type": "string",
          "default": "Standard"
        }
      },
      "required": [
        "title",
        "targetValue",
        "unit"
      ]
    },
    "GoalTools.UpdateGoal": {
      "type": "object",
      "properties": {
        "goalId": {
          "description": "The goal ID (GUID)",
          "type": "string"
        },
        "title": {
          "description": "Goal title",
          "type": "string"
        },
        "targetValue": {
          "description": "Target value",
          "type": "number"
        },
        "unit": {
          "description": "Unit of measurement",
          "type": "string"
        },
        "description": {
          "description": "Optional description",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "deadline": {
          "description": "Optional deadline in YYYY-MM-DD format",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "goalId",
        "title",
        "targetValue",
        "unit"
      ]
    },
    "HabitTools.ListHabits": {
      "type": "object",
      "properties": {
        "dateFrom": {
          "description": "Start date in YYYY-MM-DD format",
          "type": "string"
        },
        "dateTo": {
          "description": "End date in YYYY-MM-DD format",
          "type": "string"
        },
        "includeOverdue": {
          "description": "Include overdue habits",
          "type": "boolean",
          "default": true
        },
        "search": {
          "description": "Search term to filter habits",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "page": {
          "description": "Page number (default 1)",
          "type": "integer",
          "default": 1
        },
        "pageSize": {
          "description": "Page size (default 50)",
          "type": "integer",
          "default": 50
        }
      },
      "required": [
        "dateFrom",
        "dateTo"
      ]
    },
    "HabitTools.CreateHabit": {
      "type": "object",
      "properties": {
        "title": {
          "description": "Name of the habit",
          "type": "string"
        },
        "dueDate": {
          "description": "Due date in YYYY-MM-DD format",
          "type": "string"
        },
        "description": {
          "description": "Optional description",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "frequencyUnit": {
          "description": "Frequency unit: Day, Week, Month, or Year. Omit for one-time tasks.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "frequencyQuantity": {
          "description": "Frequency quantity (default 1). Omit for one-time tasks.",
          "type": [
            "integer",
            "null"
          ],
          "default": null
        },
        "isBadHabit": {
          "description": "Whether this is a bad habit to avoid",
          "type": "boolean",
          "default": false
        },
        "isGeneral": {
          "description": "Whether this is a general habit with no schedule",
          "type": "boolean",
          "default": false
        },
        "isFlexible": {
          "description": "Whether this is a flexible frequency habit",
          "type": "boolean",
          "default": false
        },
        "dueTime": {
          "description": "Due time in HH:mm format",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "intervalWeeks": {
          "description": "Repeat interval in weeks. Omit for every week.",
          "type": [
            "integer",
            "null"
          ],
          "default": null
        },
        "emoji": {
          "description": "Emoji icon for the habit",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "title",
        "dueDate"
      ]
    },
    "HabitTools.UpdateHabit": {
      "type": "object",
      "properties": {
        "habitId": {
          "description": "The habit ID (GUID)",
          "type": "string"
        },
        "title": {
          "description": "Habit title (required, pass current title if not changing)",
          "type": "string"
        },
        "description": {
          "description": "New description",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "frequencyUnit": {
          "description": "New frequency unit: Day, Week, Month, Year",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "frequencyQuantity": {
          "description": "New frequency quantity",
          "type": [
            "integer",
            "null"
          ],
          "default": null
        },
        "dueDate": {
          "description": "New due date in YYYY-MM-DD format",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "dueTime": {
          "description": "New due time in HH:mm format",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "intervalWeeks": {
          "description": "New repeat interval in weeks. Use 1 for every week.",
          "type": [
            "integer",
            "null"
          ],
          "default": null
        },
        "emoji": {
          "description": "Emoji icon. Omit to keep it, or pass null to clear it.",
          "type": [
            "string",
            "null"
          ],
          "default": ""
        }
      },
      "required": [
        "habitId",
        "title"
      ]
    },
    "HabitTools.CreateSubHabit": {
      "type": "object",
      "properties": {
        "parentHabitId": {
          "description": "The parent habit ID (GUID)",
          "type": "string"
        },
        "title": {
          "description": "Name of the sub-habit",
          "type": "string"
        },
        "description": {
          "description": "Optional description",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "frequencyUnit": {
          "description": "Frequency unit override: Day, Week, Month, Year",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "frequencyQuantity": {
          "description": "Frequency quantity override",
          "type": [
            "integer",
            "null"
          ],
          "default": null
        },
        "dueTime": {
          "description": "Due time in HH:mm format",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "isBadHabit": {
          "description": "Whether this is a bad habit",
          "type": "boolean",
          "default": false
        },
        "isFlexible": {
          "description": "Whether this is a flexible frequency habit",
          "type": "boolean",
          "default": false
        },
        "dueDate": {
          "description": "Due date override in YYYY-MM-DD format",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "parentHabitId",
        "title"
      ]
    }
  }
}
